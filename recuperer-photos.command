#!/bin/bash
# Télécharge les photos du site dans le dossier images/ (double-clic sur Mac)
cd "$(dirname "$0")"
mkdir -p images
UA="Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 Safari/605.1.15"
curl -sL -A "$UA" -o "images/salle.jpg" "https://static.wixstatic.com/media/9fc5c8_427295d5fff74b0cbe988396151c4616~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_427295d5fff74b0cbe988396151c4616.jpg" && echo "✓ salle" || echo "✗ salle"
curl -sL -A "$UA" -o "images/salle-2.jpg" "https://static.wixstatic.com/media/9fc5c8_8582dd371c544bed8a11d143a20c442f~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_8582dd371c544bed8a11d143a20c442f.jpg" && echo "✓ salle-2" || echo "✗ salle-2"
curl -sL -A "$UA" -o "images/salle-3.jpg" "https://static.wixstatic.com/media/9fc5c8_78d806c9f75142f186ac9d0c99f46aab~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_78d806c9f75142f186ac9d0c99f46aab.jpg" && echo "✓ salle-3" || echo "✗ salle-3"
curl -sL -A "$UA" -o "images/famille.jpg" "https://static.wixstatic.com/media/580cda_b9f2e045a56843e79a1723fd7ab3b455~mv2.jpg/v1/fit/w_1800,h_1800,q_85/580cda_b9f2e045a56843e79a1723fd7ab3b455.jpg" && echo "✓ famille" || echo "✗ famille"
curl -sL -A "$UA" -o "images/plat-1.jpg" "https://static.wixstatic.com/media/9fc5c8_e6661f6c51c84df888564a40c209cd78~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_e6661f6c51c84df888564a40c209cd78.jpg" && echo "✓ plat-1" || echo "✗ plat-1"
curl -sL -A "$UA" -o "images/plat-2.jpg" "https://static.wixstatic.com/media/9fc5c8_bad35ba35cb64e779e8e406401234ba3~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_bad35ba35cb64e779e8e406401234ba3.jpg" && echo "✓ plat-2" || echo "✗ plat-2"
