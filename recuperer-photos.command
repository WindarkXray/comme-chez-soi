curl -sL -A "$UA" -o "images/photo-6.jpg" "https://static.wixstatic.com/media/9fc5c8_43e935a230a04e049037b51b432b5cfe~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_43e935a230a04e049037b51b432b5cfe.jpg" && echo "✓ photo-6" || echo "✗ photo-6"
curl -sL -A "$UA" -o "images/photo-7.jpg" "https://static.wixstatic.com/media/9fc5c8_91ba0e1d065d48c0a03f3422f37bdd8c~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_91ba0e1d065d48c0a03f3422f37bdd8c.jpg" && echo "✓ photo-7" || echo "✗ photo-7"
curl -sL -A "$UA" -o "images/hist-1.jpg" "https://static.wixstatic.com/media/9fc5c8_7ba7adfeaf054b2ebf1c364726fb4765~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_7ba7adfeaf054b2ebf1c364726fb4765.jpg" && echo "✓ hist-1" || echo "✗ hist-1"
curl -sL -A "$UA" -o "images/hist-2.jpg" "https://static.wixstatic.com/media/9fc5c8_f02d7ac3f2b04cc0966007d4cb634dc1~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_f02d7ac3f2b04cc0966007d4cb634dc1.jpg" && echo "✓ hist-2" || echo "✗ hist-2"
