curl -sL -A "$UA" -o "images/plat-3.jpg" "https://static.wixstatic.com/media/9fc5c8_05b1db9a8184468da9a9183f83b85644~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_05b1db9a8184468da9a9183f83b85644.jpg" && echo "✓ plat-3" || echo "✗ plat-3"
