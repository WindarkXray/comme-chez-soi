curl -sL -A "$UA" -o "images/hist-5.jpg" "https://static.wixstatic.com/media/9fc5c8_0077927a46c7407e80c1ff5d6aaeff98~mv2.jpg/v1/fit/w_1800,h_1800,q_85/9fc5c8_0077927a46c7407e80c1ff5d6aaeff98.jpg" && echo "✓ hist-5" || echo "✗ hist-5"
curl -sL -A "$UA" -o "images/michelin-1.jpg" "https://prod-pics.guide.michelin.com/api/public/content/92fb85b779db400bad53e70ffe7cf368.jpeg?format=jpeg&w=1000&h=1000" && echo "✓ michelin-1" || echo "✗ michelin-1"
curl -sL -A "$UA" -o "images/michelin-2.jpg" "https://prod-pics.guide.michelin.com/api/public/content/bc3e8c15260b41ad80bb91025966e0c8.jpeg?format=jpeg&w=1000&h=1000" && echo "✓ michelin-2" || echo "✗ michelin-2"
curl -sL -A "$UA" -o "images/michelin-3.jpg" "https://prod-pics.guide.michelin.com/api/public/content/a7bbff9bdb0e4852ad56538819ae7d89.jpeg?format=jpeg&w=1000&h=1000" && echo "✓ michelin-3" || echo "✗ michelin-3"
echo "Terminé. Les photos sont dans le dossier images/."
